{
  "name": "performance-comparison-framework",
  "version": "1.0.0",
  "description": "Framework de comparación de rendimiento con Playwright",
  "main": "dist/main.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "build:ts": "tsc -p tsconfig.json",
    "pack": "npm run install:browsers && npm run prepare-build && electron-builder --dir",
    "build:electron": "npm run install:browsers && npm run prepare-build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "scheduler:start": "node dist/scheduler/SchedulerExecutor.js"
  },
  "keywords": [
    "playwright",
    "performance",
    "testing",
    "automation"
  ],
  "author": "Jose Colmenares (INDRA)",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.54.2",
    "dotenv": "^17.2.1",
    "open": "^10.2.0",
    "simple-statistics": "^7.8.8",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.performance-framework",
    "productName": "Performance Testing Framework",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "src/tests",
        "to": "resources/src/tests"
      },
      {
        "from": "src/data-driven",
        "to": "resources/src/data-driven"
      },
      {
        "from": ".env",
        "to": "resources/.env"
      },
      {
        "from": "playwright.config.ts",
        "to": "resources/playwright.config.ts"
      },
      {
        "from": "browsers",
        "to": "browsers"
      }
    ],
    "asarUnpack": [
      "node_modules/@playwright/**/*",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pruebas de Latencia"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "INDRA",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}