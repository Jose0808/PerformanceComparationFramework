############################################
# Application #1
############################################
APP1_NAME=Aplicativo_1
APP1_BASE_URL=https://app1.example.com
APP1_TECHNOLOGY=OnPremise
APP1_ACCOUNT_TYPE=standard
APP1_USERNAME=testuser
APP1_PASSWORD=testpass

############################################
# Application #2
############################################
APP2_NAME=Aplicativo_2
APP2_BASE_URL=https://app2-cloud.example.com
APP2_TECHNOLOGY=Cloud
APP2_ACCOUNT_TYPE=standard
APP2_USERNAME=testuser
APP2_PASSWORD=testpass

############################################
# Environment Config
############################################
ENVIRONMENT=pre
NETWORK_CONDITIONS=4g
PARALLEL_INSTANCES=1
ITERATIONS=3

############################################
# Browser & Device Configuration
############################################
BROWSER_TYPE=chromium
DEVICE_TYPE=desktop
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
HEADLESS_MODE=true
DISABLE_IMAGES=false
DISABLE_JAVASCRIPT=false

############################################
# Network Throttling
############################################
NETWORK_DOWNLOAD_THROUGHPUT=1500000
NETWORK_UPLOAD_THROUGHPUT=750000
NETWORK_LATENCY=20
NETWORK_PACKET_LOSS=0

############################################
# Timeouts & Retries
############################################
LOAD_TIMEOUT=15000
RETRY_COUNT=2
SCENARIO_TIMEOUT_MULTIPLIER=1.5

############################################
# Test Execution Strategy
############################################
COOLDOWN_BETWEEN_RUNS=5000
BROWSER_RESTART_FREQUENCY=10
CLEAR_CACHE_BETWEEN_RUNS=true
CLEAR_COOKIES_BETWEEN_RUNS=true
RUN_PARALLEL=true
WORKER_COUNT=3
ITERATION_COUNT=5
CONTINUE_ON_FAILURE=true
MAX_CONSECUTIVE_FAILURES=3

############################################
# Metrics Flags
############################################
CAPTURE_WEB_VITALS=true
CAPTURE_NETWORK_METRICS=true
CAPTURE_CUSTOM_METRICS=true
MONITOR_MEMORY_USAGE=true
MONITOR_CPU_USAGE=true
CAPTURE_CONSOLE_LOGS=true
CAPTURE_NETWORK_LOGS=true

############################################
# Thresholds - Core Web Vitals
############################################
THRESHOLD_LCP=2500
THRESHOLD_FID=100
THRESHOLD_INP=200
THRESHOLD_CLS=0.1

############################################
# Thresholds - Performance Metrics
############################################
THRESHOLD_TTFB=500
THRESHOLD_FCP=1500
THRESHOLD_TTI=3000
THRESHOLD_DNS_RESOLUTION=200
THRESHOLD_SSL_HANDSHAKE=300
THRESHOLD_JS_LOAD_TIME=1000
THRESHOLD_CSS_LOAD_TIME=800
THRESHOLD_IMG_LOAD_TIME=1200
THRESHOLD_TOTAL_LOAD_TIME=5000

############################################
# Thresholds - Custom Application Metrics
############################################
THRESHOLD_LOGIN_TIME=2000
THRESHOLD_DASHBOARD_LOAD_TIME=3000
THRESHOLD_FORM_PROCESSING_TIME=1000
THRESHOLD_MODULE_NAVIGATION_TIME=1500

############################################
# Reporting Configuration
############################################
OUTPUT_PATH=./reports
REPORT_FORMAT=html,json
GENERATE_SCREENSHOTS=true
GENERATE_VIDEO_RECORDING=true

############################################
# Resource Monitoring
############################################
MEMORY_THRESHOLD_MB=2048
CPU_THRESHOLD_PERCENTAGE=80
LOG_LEVEL=info

############################################
# Failure Handling
############################################
FAILURE_SCREENSHOT=true

############################################
# Pipeline Config (Future)
############################################
PIPELINE_MODE=false
SLACK_WEBHOOK_URL=
EMAIL_RECIPIENTS=
BASELINE_BRANCH=main
GIT_BRANCH=${CI_COMMIT_REF_NAME}
GIT_COMMIT=${CI_COMMIT_SHA}
BUILD_NUMBER=${CI_PIPELINE_ID}